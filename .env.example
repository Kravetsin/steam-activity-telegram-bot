# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# LLM API key (any OpenAI-compatible provider)
# Default provider is Groq — get a key at https://console.groq.com/keys
LLM_API_KEY=

# LLM API base URL — change this to swap provider. Examples:
#   Groq:       https://api.groq.com/openai/v1   (default)
#   OpenRouter: https://openrouter.ai/api/v1
#   Together:   https://api.together.xyz/v1
#   OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# LLM model ID (provider-specific). Groq free options:
#   llama-3.3-70b-versatile   — bigger / better roleplay, 30 RPM, 1000 RPD (default)
#   llama-3.1-8b-instant      — much higher daily ceiling (14400 RPD), fast, smaller
#   deepseek-r1-distill-llama-70b — reasoning-tuned
LLM_MODEL=llama-3.3-70b-versatile

# MongoDB connection string (Atlas / Render / etc.)
MONGODB_URI=

# Optional: bot display name used in persona prompt and logs
BOT_NAME=

# Optional: hour of the day (0-23, local time) when daily context cleanup + fact extraction runs
DAILY_RESET_HOUR=4

# Optional: number of recent messages per chat passed to LLM as conversation context
CONTEXT_WINDOW=25

# Optional: override DNS servers (comma-separated). Useful only if local system DNS doesn't handle SRV records (VPN/antivirus). Leave empty in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional but RECOMMENDED for hosted deployments: public HTTPS domain that Telegram can reach.
# When set, the bot uses webhook mode (Telegram pushes updates → our endpoint) instead of polling.
# Eliminates 409 conflicts and duplicate-handler races, prevents Render free-tier sleep.
# When empty (local dev), bot falls back to long-polling.
# WEBHOOK_DOMAIN=https://steam-activity-telegram-bot.onrender.com
