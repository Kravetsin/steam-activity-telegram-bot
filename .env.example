# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# API key: https://console.anthropic.com/settings/keys
# Set a monthly spend limit on the key — the bot is a hobby project, not a startup.
ANTHROPIC_API_KEY=

# Main chat model. Available: claude-sonnet-5-5, claude-haiku-5-5, claude-opus-5-5.
# Sonnet 5.5: best roleplay, ~$6.5 per 1000 replies.
# Haiku 5.5: ~20x cheaper, a bit less nuanced — good first choice while testing.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Model for background/utility calls: fact extraction, persona detection,
# image-prompt translation. Haiku is plenty and keeps the background cheap.
ANTHROPIC_UTILITY_MODEL=claude-haiku-5-5

# Max output tokens. Chat replies are 1-3 sentences; 1024 is generous.
# If you enable adaptive thinking, raise it (thinking tokens count here too).
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_UTILITY_MAX_TOKENS=4096

# How hard the model works. For a chat bot "low" keeps latency down.
# Allowed: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
ANTHROPIC_UTILITY_EFFORT=medium

# Thinking mode. "auto" picks the correct value for the model:
#   Sonnet 5.5 → between_tools (it rejects "disabled" with a 400)
#   Haiku 5.5  → disabled
# Force one with: auto | disabled | between_tools | adaptive | off
ANTHROPIC_THINKING=auto

# Optional: route requests through a proxy/gateway that speaks the Claude API.
# Useful if the VPS region can't reach api.anthropic.com directly.
# ANTHROPIC_BASE_URL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Postgres credentials. `docker compose` derives DATABASE_URL from these, so the
# password is written in one place only. Keep it URL-safe: openssl rand -hex 24
POSTGRES_DB=steam_bot
POSTGRES_USER=steam_bot
POSTGRES_PASSWORD=

# Only needed outside Docker (e.g. `npm start` against a local Postgres).
# DATABASE_URL=postgres://steam_bot:secret@127.0.0.1:5432/steam_bot

# ── Bot behaviour ────────────────────────────────────────────────────────────
# Optional: bot display name used in persona prompt and logs
BOT_NAME=

# Optional: hour of the day (0-23, local time) when daily context cleanup + fact extraction runs
DAILY_RESET_HOUR=4

# Optional: Telegram user ids allowed to talk to the bot in a private chat,
# comma-separated (get yours from @userinfobot). Empty or unset = DMs ignored.
# TELEGRAM_DM_ALLOWED_IDS=123456789

# Optional: number of recent messages per chat passed to LLM as conversation context
CONTEXT_WINDOW=25

# Optional: override DNS servers (comma-separated). Only needed if the local system DNS
# misbehaves (VPN/antivirus). Leave empty in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Deployment ───────────────────────────────────────────────────────────────
# Optional: public HTTPS domain that Telegram can reach.
# When set, the bot uses webhook mode instead of long-polling.
# Behind Caddy/nginx keep HOST=127.0.0.1 so the app isn't exposed directly.
# WEBHOOK_DOMAIN=https://bot.example.com
# HOST=127.0.0.1
# PORT=3000
