# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# MongoDB connection string (Atlas / Render / etc.)
MONGODB_URI=

# Optional: bot display name used in persona prompt
BOT_NAME=

# Optional: Gemini model name. Free tier options: gemini-2.5-flash-lite (15 RPM, 1000 RPD), gemini-2.5-flash (10 RPM, 250 RPD)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: hour of the day (0-23, local time) when daily context cleanup + fact extraction runs
DAILY_RESET_HOUR=4

# Optional: number of recent messages per chat passed to Gemini as conversation context
CONTEXT_WINDOW=25

# Optional: override DNS servers (comma-separated). Useful if your system DNS resolver doesn't handle SRV records (e.g. due to VPN/antivirus). Leave empty in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1
